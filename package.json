{
  "name": "doxxta",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "predev": "node scripts/copy-vendor.mjs",
    "prebuild": "node scripts/copy-vendor.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "preview": "vite preview",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:smoke": "npm run build && node tests/e2e/smoke.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "desktop": "npm run build && node scripts/desktop.mjs start",
    "dist:win": "npm run build && node scripts/desktop.mjs dist --win",
    "dist:mac": "npm run build && node scripts/desktop.mjs dist --mac",
    "dist:linux": "npm run build && node scripts/desktop.mjs dist --linux",
    "test:desktop": "npm run build && node tests/desktop/run.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:icons": "node scripts/mobile-icons.mjs",
    "test:android": "node tests/mobile/android-smoke.mjs"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "diff": "^9.0.0",
    "docx": "^9.13.0",
    "fflate": "^0.8.3",
    "html-entities": "^2.6.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.64.1",
    "typescript": "5.9",
    "vite": "^8.3.5"
  }
}
